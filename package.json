{
  "name": "zeno",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "typecheck": "nx run-many -t typecheck",
    "generate": "nx run @usezeno/core:build && node scripts/generate-bindings.mjs",
    "generate:check": "nx run @usezeno/core:build && node scripts/generate-bindings.mjs --check",
    "check:entry-points": "node scripts/check-entry-points.mjs",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "storybook": "pnpm --filter @usezeno/storybook dev",
    "build-storybook": "nx run @usezeno/storybook:build-storybook",
    "docs:dev": "pnpm --filter @usezeno/docs start",
    "docs:build": "nx run @usezeno/docs:build-docs",
    "changeset": "changeset",
    "release:check": "node scripts/check-packages.mjs",
    "release:version": "changeset version && node scripts/release-changelog.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-lit": "^2.3.1",
    "eslint-plugin-vue": "^10.12.1",
    "eslint-plugin-vuejs-accessibility": "^2.6.3",
    "eslint-plugin-wc": "^3.1.0",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "nx": "24.0.6",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vue-eslint-parser": "^10.3.0"
  }
}
