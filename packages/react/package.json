{
  "name": "@usezeno/react",
  "version": "0.0.0",
  "private": true,
  "description": "Zeno for React",
  "license": "MIT",
  "homepage": "https://zeno.thecipherlabs.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cipherlabs-hq/zeno.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/cipherlabs-hq/zeno/issues"
  },
  "keywords": [
    "react",
    "web-components",
    "design-system",
    "zeno"
  ],
  "type": "module",
  "sideEffects": true,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@lit/react": "^1.0.8",
    "@usezeno/core": "workspace:*"
  },
  "peerDependencies": {
    "@types/react": "^18.0.0 || ^19.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "react": "^19.3.1"
  }
}
