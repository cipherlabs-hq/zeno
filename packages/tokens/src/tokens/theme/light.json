  "shadow": {
    "$type": "shadow",
    "none": {
      "$value": "none"
    },
    "xs": {
      "$value": "0 1px 2px 0 rgba(16, 18, 21, 0.06)"
    },
    "sm": {
      "$value": "0 1px 3px 0 rgba(16, 18, 21, 0.1), 0 1px 2px -1px rgba(16, 18, 21, 0.08)"
    },
    "md": {
      "$value": "0 4px 8px -2px rgba(16, 18, 21, 0.1), 0 2px 4px -2px rgba(16, 18, 21, 0.06)"
    },
    "lg": {
      "$value": "0 12px 20px -4px rgba(16, 18, 21, 0.12), 0 4px 8px -4px rgba(16, 18, 21, 0.06)"
    },
    "xl": {
      "$value": "0 20px 32px -8px rgba(16, 18, 21, 0.16), 0 8px 12px -6px rgba(16, 18, 21, 0.06)"
    },
    "2xl": {
      "$value": "0 28px 56px -12px rgba(16, 18, 21, 0.24)"
    },
