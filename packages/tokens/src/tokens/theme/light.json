{
  "color": {
    "$type": "color",
    "background": {
      "page": {
        "$value": "{palette.gray.50}",
        "$description": "The application canvas."
      },
      "surface": {
        "$value": "{palette.gray.0}",
        "$description": "Cards, fields, menus and dialogs."
      },
      "subtle": {
        "$value": "{palette.gray.100}",
        "$description": "A quiet fill: table headers, wells, secondary panels."
      },
      "muted": {
        "$value": "{palette.gray.200}",
        "$description": "A stronger quiet fill: tracks, skeletons."
      },
      "hover": {
        "$value": "rgba(16, 18, 21, 0.06)",
        "$description": "Layered over any background when a neutral item is hovered."
      },
      "active": {
        "$value": "rgba(16, 18, 21, 0.1)",
        "$description": "Layered over any background while a neutral item is pressed."
      },
      "selected": {
        "$value": "{palette.blue.50}",
        "$description": "A selected row, option or tab."
      },
      "disabled": {
        "$value": "{palette.gray.100}",
        "$description": "Fill of a disabled control."
      },
      "inverse": {
        "$value": "{palette.gray.900}",
        "$description": "Tooltips and other inverted surfaces."
      },
      "scrim": {
        "$value": "rgba(16, 18, 21, 0.5)",
        "$description": "The backdrop behind a modal dialog or drawer."
      }
    },
    "text": {
      "primary": {
        "$value": "{palette.gray.950}"
      },
      "secondary": {
        "$value": "{palette.gray.700}"
      },
      "tertiary": {
        "$value": "{palette.gray.600}",
        "$description": "Captions and hints. Passes 4.5:1 on page, surface and subtle; do not use on muted."
      },
      "placeholder": {
        "$value": "{palette.gray.600}"
      },
      "disabled": {
        "$value": "{palette.gray.400}",
        "$description": "Disabled text is exempt from WCAG contrast minimums."
      },
      "inverse": {
        "$value": "{palette.gray.50}",
        "$description": "Text on the inverse background."
      },
      "invalid": {
        "$value": "{palette.red.700}"
      }
    },
    "border": {
      "subtle": {
        "$value": "{palette.gray.200}",
        "$description": "Decorative dividers."
      },
      "default": {
        "$value": "{palette.gray.300}",
        "$description": "Decorative borders of cards and panels."
      },
      "strong": {
        "$value": "{palette.gray.400}",
        "$description": "Emphasised decorative borders."
      },
      "control": {
        "$value": "{palette.gray.500}",
        "$description": "The boundary of a form control. Passes 3:1 on page, surface and subtle."
      },
