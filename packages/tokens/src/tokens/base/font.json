{
  "font": {
    "family": {
      "$type": "fontFamily",
      "$description": "IBM Plex is named first and is not bundled. Load it yourself or the system stack is used.",
      "sans": {
        "$value": [
          "IBM Plex Sans",
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "Roboto",
          "Helvetica Neue",
          "Arial",
          "sans-serif"
        ]
      },
      "mono": {
        "$value": [
          "IBM Plex Mono",
          "ui-monospace",
          "SFMono-Regular",
          "Menlo",
          "Consolas",
          "Liberation Mono",
          "monospace"
        ]
      }
    },
    "size": {
      "$type": "dimension",
      "2xs": {
        "$value": "0.6875rem"
      },
      "xs": {
        "$value": "0.75rem"
      },
      "sm": {
        "$value": "0.875rem"
      },
      "md": {
        "$value": "1rem"
      },
      "lg": {
        "$value": "1.125rem"
      },
      "xl": {
        "$value": "1.25rem"
      },
      "2xl": {
        "$value": "1.5rem"
      },
      "3xl": {
        "$value": "1.875rem"
      },
      "4xl": {
        "$value": "2.25rem"
      },
      "5xl": {
        "$value": "3rem"
      },
      "6xl": {
        "$value": "3.75rem"
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "semibold": {
        "$value": 600
      },
      "bold": {
        "$value": 700
      }
    },
    "lineHeight": {
      "$type": "number",
      "none": {
        "$value": 1
      },
      "tight": {
        "$value": 1.25
      },
      "snug": {
        "$value": 1.375
      },
      "normal": {
        "$value": 1.5
      },
      "relaxed": {
        "$value": 1.625
      }
    },
    "letterSpacing": {
      "$type": "dimension",
      "tight": {
        "$value": "-0.02em"
      },
      "normal": {
        "$value": "0"
      },
      "wide": {
        "$value": "0.02em"
      },
      "wider": {
        "$value": "0.05em"
      }
    }
  }
}
