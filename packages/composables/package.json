{
  "name": "@usezeno/composables",
  "version": "0.0.0",
  "description": "Vue composables that accompany the Zeno Vue components",
  "license": "MIT",
  "homepage": "https://zeno.thecipherlabs.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cipherlabs-hq/zeno.git",
    "directory": "packages/composables"
  },
  "bugs": {
    "url": "https://github.com/cipherlabs-hq/zeno/issues"
  },
  "keywords": [
    "vue",
    "composables",
    "design-system",
    "zeno"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@usezeno/core": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "vue": "^3.5.45"
  }
}
