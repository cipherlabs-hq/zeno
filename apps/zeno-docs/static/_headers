# Response headers for Cloudflare Pages. Nothing else reads this file.
#
# The content security policy fits what the build writes:
#   - one inline script, the one that sets the theme before the page paints.
#     Its hash is below. scripts/check-headers.mjs runs after every build and
#     fails when an inline script in build/ is not covered, and prints the
#     hash to put here.
#   - inline style attributes, which Docusaurus and the token samples use, so
#     style-src needs 'unsafe-inline'.
#   - images from this site and from data: URLs (the icons in the site theme).
#   - nothing from any other origin: no fonts, analytics, search or frames.
#
# Turning on Cloudflare Web Analytics, or anything else that adds a script from
# another origin, needs a change here first.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-0xt7rjlfRsoD7aukiSWSNvMBWU159Lh5cl3WNaV1g+w='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000

# File names under /assets carry a hash of their contents.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Preview deployments stay out of search engines.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex
